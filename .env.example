# Copy this file to .env and fill in real values. Never commit .env itself.

# The wallet that will deploy the contract (needs testnet BOT from the faucet).
# Export this from BO Wallet / MetaMask. Starts with 0x, 64 hex chars after that.
PRIVATE_KEY=0xyourprivatekeyhere

# Get these from https://faucet.botchain.ai/basic after connecting your wallet
# (the "add network" flow there will show you the exact RPC URL + chain ID).
BOTCHAIN_TESTNET_RPC=https://replace-with-real-testnet-rpc.botchain.ai
BOTCHAIN_TESTNET_CHAIN_ID=6770

# Only needed once you're ready to deploy for real (after Demo Day judging,
# or if the challenge explicitly wants mainnet).
BOTCHAIN_MAINNET_RPC=https://replace-with-real-mainnet-rpc.botchain.ai
